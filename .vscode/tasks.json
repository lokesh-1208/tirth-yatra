{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: run",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "windows": {
        "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\uvicorn app.main:app --reload --port 8000"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: web",
      "type": "shell",
      "command": "npx expo start --web",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "windows": { "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python -m pytest -q" },
      "problemMatcher": []
    },
    {
      "label": "automation: api tests",
      "type": "shell",
      "command": "npm run test:api",
      "options": { "cwd": "${workspaceFolder}/automation" },
      "problemMatcher": []
    },
    {
      "label": "automation: ui tests",
      "type": "shell",
      "command": "npm run test:ui",
      "options": { "cwd": "${workspaceFolder}/automation" },
      "problemMatcher": []
    },
    {
      "label": "start everything",
      "dependsOn": ["backend: run", "frontend: web"],
      "problemMatcher": []
    }
  ]
}
