DATABASE_URL=sqlite:///./tirth.db
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=*
# Dev/test dummy user + @qa.tirthyatra.app emails accept OTP 999999. Set false in production!
ENABLE_TEST_USER=true
# Geocoding (Nominatim) + road routing (OSRM). Defaults are the free public servers (light use only).
EXTERNAL_GEO_ENABLED=true
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEOCODE_COUNTRY_CODES=in
# Admin section: emails / phones (comma-separated) that become curators when they log in.
# CURATOR_IDENTIFIERS=you@example.com,9876543210
# Language of a place's own text fields; other languages are stored as translations.
# DEFAULT_LANGUAGE=en
# Uploaded place photos (served at /uploads). Use object storage in production.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=5
# Map tiles for the app's maps, served through /tiles with a disk cache. OpenStreetMap is for light use only.
# TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_CACHE_DIR=tile-cache
# HTTP_USER_AGENT="TirthYatra/0.1 (contact: you@example.com)"
# Emails / phones (comma-separated) that become admins when they log in. Put your own here.
# ADMIN_IDENTIFIERS=you@example.com
# Wrong OTP codes in a row before logins are blocked, and for how long.
# OTP_MAX_FAILURES=10
# OTP_BLOCK_MINUTES=30
